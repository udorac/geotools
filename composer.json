{
    "name"        : "udorac/geotools",
    "type"        : "library",
    "description" : "Geo-related tools PHP 8.1+ library",
    "keywords"    : ["geotools", "geometry", "bounds", "distance", "geohash", "latlong", "latitude", "longitude"],
    "license"     : "MIT",

    "authors" : [{
        "name"     : "Antoine Corcy",
        "email"    : "contact@sbin.dk",
        "homepage" : "http://sbin.dk",
        "role"     : "Developer"
    }],

    "support" : {
        "issues" : "https://github.com/udorac/geotools/issues",
        "source" : "https://github.com/udorac/geotools"
    },

    "replace" : {
        "league/geotools" : "*",
        "toin0u/geotools" : "*"
    },

    "require" : {
        "php"                     : "^7.3 || ^7.4 || ^8.0",
        "react/promise"           : "^2.8 || ^3.0",
        "symfony/console"         : "^4.4 || ^5.0 || ^6.0 || ^7.0",
        "symfony/property-access" : "^4.4 || ^5.0 || ^6.0 || ^7.0",
        "symfony/serializer"      : "^4.4 || ^5.0 || ^6.0 || ^7.0",
        "php-http/discovery"      : "^1.0",
        "ext-bcmath": "*",
        "ext-json": "*"
    },

    "require-dev" : {
        "phpunit/phpunit"         : "^10.0"
    },

    "autoload" : {
        "psr-4" : {
            "League\\Geotools\\"        : "src"
        }
    },

    "autoload-dev" : {
        "psr-4" : {
             "League\\Geotools\\Tests\\" : "tests"
        }
    },

    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
